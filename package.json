{
  "name": "campus-241",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@campus241/web",
    "dev:admin": "npm run dev --workspace=@campus241/admin",
    "build": "npm run build --workspace=@campus241/web",
    "build:admin": "npm run build --workspace=@campus241/admin",
    "lint": "npm run lint --workspace=@campus241/web && npm run lint --workspace=@campus241/admin",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=@campus241/shared",
    "db:seed": "npm run db:seed --workspace=@campus241/shared"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
