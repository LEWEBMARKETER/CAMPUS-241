# PostgreSQL (Neon en production, instance locale en dev) — même base que apps/web
DATABASE_URL="postgresql://user:password@host:5432/campus241?sslmode=require"

# NextAuth — même AUTH_SECRET/NEXTAUTH_SECRET que apps/web pour que la
# session soit valide côté back-office (même sans domaine partagé, une
# connexion admin doit pouvoir être vérifiée avec le même secret).
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3001"

# URL publique de la plateforme (bouton "Voir la plateforme")
NEXT_PUBLIC_WEB_URL="http://localhost:3000"

# Optionnel : voir apps/web/.env.example — même valeur des deux côtés une
# fois un domaine personnalisé en place, pour une connexion unique.
AUTH_COOKIE_DOMAIN=""
