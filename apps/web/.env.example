# PostgreSQL (Neon en production, instance locale en dev)
DATABASE_URL="postgresql://user:password@host:5432/campus241?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# URL publique du back-office (bouton "Admin" dans le header)
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"

# Optionnel : une fois un domaine personnalisé en place, définir la même
# valeur ici et sur apps/admin pour partager la session entre les deux apps
# (ex: ".campus241.ga"). Laisser vide tant qu'il n'y a pas de domaine réel.
AUTH_COOKIE_DOMAIN=""

# Cloudinary (stockage images)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (emails transactionnels)
RESEND_API_KEY=""
